    <entry key="JDBC_VIRTUAL_TABLE">
      <virtualTable>
        <name>timeDalibor</name>
        <sql>WITH sub as (&#xd;
	SELECT q.geom_wgs, max(EXTRACT(YEAR FROM r.datum)) as newest_occurrence&#xd;
&#xd;
FROM atlas.records r &#xd;
LEFT JOIN geodata.quadrants_full q ON (ST_Within(r.coords_wgs, q.geom_wgs))&#xd;
JOIN geodata.squares_full s ON (q.square_id=s.id)&#xd;
JOIN geodata.squares_countries rel ON (rel.square_id=s.id)&#xd;
&#xd;
WHERE &#xd;
 r.taxon_id = %TAXON_ID%&#xd;
 AND r.validation_status IN (0,3)&#xd;
 AND rel.country_id = 1&#xd;
 &#xd;
 GROUP BY q.id)&#xd;
SELECT geom_wgs, CASE&#xd;
	   WHEN newest_occurrence &lt; %YEAR% THEN &apos;old&apos;&#xd;
	   WHEN newest_occurrence &gt;= %YEAR% THEN &apos;new&apos;         &#xd;
	   WHEN newest_occurrence is null THEN &apos;empty&apos; &#xd;
	END status &#xd;
from sub
</sql>
        <escapeSql>false</escapeSql>
        <geometry>
          <name>geom_wgs</name>
          <type>MultiPolygon</type>
          <srid>4326</srid>
