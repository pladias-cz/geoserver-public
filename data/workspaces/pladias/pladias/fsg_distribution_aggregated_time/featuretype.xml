        <name>fsg_distribution_aggregated_time</name>
        <sql>WITH sub as (select * FROM bayernflora.geoserver_distribution_aggregated_time &#xd;
 WHERE fsg_taxon=%TAXON_ID% )&#xd;
SELECT *, CASE&#xd;
	   WHEN max_year &lt; %YEAR% THEN &apos;old&apos;&#xd;
	   WHEN max_year &gt;= %YEAR% THEN &apos;new&apos;         &#xd;
	END status &#xd;
from sub &#xd;
WHERE max_year IS NOT NULL
</sql>
